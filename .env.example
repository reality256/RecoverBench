# 用法:复制本文件为 .env(cp .env.example .env),再填入真实值。
# .env 已被 .gitignore 忽略,永远不会被提交;本文件(.env.example)会被提交,
# 所以【绝对不要】把真实 key 写在这里。

# API key(必填):https://platform.deepseek.com 申请
LLM_API_KEY=

# 模型名称(选填)。当前可用:deepseek-flash(快、便宜,适合反复跑实验)、
# deepseek-v4-pro(更强,适合对比实验)。
# 注意:deepseek-chat / deepseek-reasoner 是已弃用的兼容别名,别再用。
LLM_MODEL=deepseek-flash

# API 地址(选填,OpenAI 兼容接口;换供应商时改这里)
LLM_BASE_URL=https://api.deepseek.com/v1

# 单次模型调用的请求超时秒数(选填,默认 30;实际会被"整轮剩余时间"夹住)
LLM_TIMEOUT=30

# 单次输出 token 上限(选填,默认 1024)
LLM_MAX_TOKENS=1024
